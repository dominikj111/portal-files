{
  "name": "portal-files",
  "version": "1.0.0",
  "description": "Local file server with web UI for browsing and downloading files",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\" \"static/**/*.{html,css}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"static/**/*.{html,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
